{
  "name": "ceauto",
  "version": "0.14.2",
  "description": "Autonomous CEO Agent — LLM-agnostic MCP server with multi-agent orchestration",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "daemon": "node bin/ceauto-daemon.js",
    "cycle": "node bin/ceauto-daemon.js --once",
    "dashboard": "node bin/ceauto-dashboard.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.2.0",
    "chokidar": "^3.6.0",
    "js-yaml": "^4.1.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
